# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000
API_PORT=4000
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1

# Local docker-compose defaults. Change before exposing services outside your machine.
POSTGRES_PASSWORD=gharsync-local
DATABASE_URL=postgresql://gharsync:gharsync-local@localhost:5432/gharsync?schema=public
REDIS_URL=redis://localhost:6379

# Generate each secret separately with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HMAC_SECRET=

# Optional delivery adapters. Both adapters require the provider to confirm delivery.
# Expected HTTP contract: POST JSON with a Bearer API key; SMS body {to,message};
# email body {to,subject,text}. Leave blank until a compatible provider is configured.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=

# Private local document storage used by the development adapter; not web-served directly.
DOCUMENT_STORAGE_PATH=../../var/documents
