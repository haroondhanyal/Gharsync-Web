generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  TECHNICIAN
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  REQUESTED
  UNDER_REVIEW
  QUOTED
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  ASSIGNED
  TECHNICIAN_EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PropertyType {
  HOUSE
  APARTMENT
  COMMERCIAL
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  DIGITAL_WALLET
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RELEASE
  CONSUMPTION
  TRANSFER_IN
  TRANSFER_OUT
}

enum WarrantyClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RESOLVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum OrganizationVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String                 @id @default(uuid()) @db.Uuid
  email        String                 @unique @db.VarChar(320)
  phone        String?                @db.VarChar(32)
  fullName     String                 @db.VarChar(160)
  passwordHash String                 @db.VarChar(255)
  phoneVerifiedAt DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?
  memberships  OrganizationMember[]
  bookingEvents BookingEvent[]
  sessions      RefreshSession[]
  otpChallenges OtpChallenge[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]
  createdInvites OrganizationInvite[] @relation("InviteCreator")
  acceptedInvites OrganizationInvite[] @relation("InviteAccepter")
  uploadedDocuments Document[] @relation("DocumentUploader")
  createdQuotes Quote[] @relation("QuoteCreator")
  createdInvoices Invoice[] @relation("InvoiceCreator")
  recordedPayments Payment[] @relation("PaymentRecorder")
  verifiedPayments Payment[] @relation("PaymentVerifier")
  processedRefunds Refund[]
  reviewedTimeOff TechnicianTimeOff[] @relation("TimeOffReviewer")
  createdStockMovements StockMovement[] @relation("StockMovementCreator")
  notifications NotificationLog[]
  aiUsageLogs AiUsageLog[]
  supportTickets SupportTicket[]

  @@index([phone])
  @@map("users")
}

model Organization {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @db.VarChar(180)
  slug        String               @unique @db.VarChar(100)
  businessType String?             @db.VarChar(80)
  verificationStatus OrganizationVerificationStatus @default(UNVERIFIED)
  currency    String               @default("PKR") @db.Char(3)
  timezone    String               @default("Asia/Karachi") @db.VarChar(64)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  members     OrganizationMember[]
  branches    Branch[]
  customers   Customer[]
  properties  Property[]
  assets      Asset[]
  services    Service[]
  bookings    Booking[]
  events      BookingEvent[]
  sessions    RefreshSession[]
  auditLogs   AuditLog[]
  invites     OrganizationInvite[]
  documents   Document[]
  serviceLinks ServiceBranch[]
  quotes      Quote[]
  invoices    Invoice[]
  payments    Payment[]
  refunds     Refund[]
  suppliers Supplier[]
  inventoryProducts InventoryProduct[]
  stocks InventoryStock[]
  stockMovements StockMovement[]
  warrantyClaims WarrantyClaim[]
  technicianProfiles TechnicianProfile[]
  notifications NotificationLog[]
  aiUsageLogs AiUsageLog[]
  subscriptions Subscription[]
  supportTickets SupportTicket[]

  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(STAFF)
  status         MemberStatus     @default(INVITED)
  invitedAt      DateTime         @default(now())
  joinedAt       DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId       String?          @db.Uuid
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedBookings Booking[]      @relation("BookingAssignee")
  technicianProfile TechnicianProfile?

  @@unique([organizationId, userId])
  @@index([organizationId, role, status])
  @@index([branchId])
  @@map("organization_members")
}

model Branch {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  name           String               @db.VarChar(160)
  city           String               @db.VarChar(100)
  address        String?              @db.VarChar(500)
  phone          String?              @db.VarChar(32)
  isDefault      Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  bookings       Booking[]
  customers      Customer[]
  invites        OrganizationInvite[]
  serviceLinks   ServiceBranch[]
  documents      Document[]
  quotes         Quote[]
  invoices       Invoice[]
  payments       Payment[]
  refunds        Refund[]
  stocks InventoryStock[]
  stockMovements StockMovement[]
  warrantyClaims WarrantyClaim[]

  @@unique([organizationId, name])
  @@index([organizationId, city])
  @@map("branches")
}

model Customer {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  fullName       String            @db.VarChar(160)
  phone          String            @db.VarChar(32)
  email          String?           @db.VarChar(320)
  notes          String?           @db.Text
  tags           String[]          @default([])
  isActive       Boolean           @default(true)
  branchId       String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  addresses      CustomerAddress[]
  properties     Property[]
  bookings       Booking[]
  documents      Document[]

  @@index([organizationId, phone])
  @@index([organizationId, fullName])
  @@index([organizationId, isActive, createdAt])
  @@index([branchId, isActive])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  label      String?  @db.VarChar(60)
  address    String   @db.VarChar(500)
  city       String   @db.VarChar(100)
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

model Property {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  customerId     String       @db.Uuid
  name           String       @db.VarChar(120)
  propertyType   PropertyType @default(HOUSE)
  address        String       @db.VarChar(500)
  city           String       @db.VarChar(100)
  ownership      String?      @db.VarChar(20)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assets         Asset[]
  bookings       Booking[]
  documents      Document[]
  latitude       Decimal?     @db.Decimal(10, 7)
  longitude      Decimal?     @db.Decimal(10, 7)

  @@index([organizationId, customerId])
  @@index([organizationId, city])
  @@map("properties")
}

model Asset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  propertyId     String       @db.Uuid
  category       String       @db.VarChar(80)
  brand          String?      @db.VarChar(100)
  model          String?      @db.VarChar(100)
  serialNumber   String?      @db.VarChar(120)
  qrCode         String       @unique @default(uuid()) @db.VarChar(120)
  purchasedAt    DateTime?
  installedAt    DateTime?
  warrantyStartsAt DateTime?
  warrantyEndsAt DateTime?
  purchasePrice  Decimal?     @db.Decimal(12, 2)
  seller         String?      @db.VarChar(180)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  documents      Document[]
  warrantyClaims WarrantyClaim[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId, category])
  @@index([propertyId])
  @@map("assets")
}

model Service {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(160)
  category       String       @db.VarChar(80)
  description    String?      @db.Text
  basePrice      Decimal?     @db.Decimal(12, 2)
  durationMins   Int?
  minPrice       Decimal?     @db.Decimal(12, 2)
  maxPrice       Decimal?     @db.Decimal(12, 2)
  requiredSkills String[]     @default([])
  serviceAreas   String[]     @default([])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  branchLinks    ServiceBranch[]

  @@unique([organizationId, name])
  @@index([organizationId, category, isActive])
  @@map("services")
}

model ServiceBranch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  serviceId      String       @db.Uuid
  branchId       String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([serviceId, branchId])
  @@index([organizationId, branchId])
  @@map("service_branches")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String?       @db.Uuid
  customerId     String        @db.Uuid
  propertyId     String?       @db.Uuid
  assetId        String?       @db.Uuid
  serviceId      String?       @db.Uuid
  status         BookingStatus @default(REQUESTED)
  urgency        String        @default("NORMAL") @db.VarChar(20)
  description    String?       @db.Text
  internalNotes  String?       @db.Text
  preferredAt    DateTime?
  scheduledAt    DateTime?
  latitude       Decimal?      @db.Decimal(10, 7)
  longitude      Decimal?      @db.Decimal(10, 7)
  assignedMemberId String?     @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  asset          Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignedMember OrganizationMember? @relation("BookingAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  events         BookingEvent[]
  quotes         Quote[]
  invoices       Invoice[]
  documents      Document[]
  stockMovements StockMovement[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, branchId, scheduledAt])
  @@index([customerId, createdAt])
  @@index([organizationId, assignedMemberId, scheduledAt])
  @@map("bookings")
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String?      @db.Uuid
  uploaderId     String       @db.Uuid
  customerId     String?      @db.Uuid
  propertyId     String?      @db.Uuid
  assetId        String?      @db.Uuid
  bookingId      String?      @db.Uuid
  fileName       String       @db.VarChar(255)
  storageKey     String       @unique @db.VarChar(120)
  mimeType       String       @db.VarChar(120)
  sizeBytes      Int
  checksum       String       @db.Char(64)
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  uploader       User         @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  asset          Asset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  booking        Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([organizationId, branchId, createdAt])
  @@index([customerId, createdAt])
  @@index([propertyId, createdAt])
  @@index([assetId, createdAt])
  @@index([bookingId, createdAt])
  @@map("documents")
}

model Quote {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String?      @db.Uuid
  bookingId      String       @db.Uuid
  revision       Int
  status         QuoteStatus  @default(DRAFT)
  currency       String       @default("PKR") @db.Char(3)
  subtotal       Decimal      @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  tax            Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  notes          String?      @db.Text
  validUntil     DateTime?
  createdById    String       @db.Uuid
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items          QuoteItem[]
  invoice        Invoice?

  @@unique([bookingId, revision])
  @@index([organizationId, branchId, status, createdAt])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid()) @db.Uuid
  quoteId     String   @db.Uuid
  description String   @db.VarChar(240)
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@map("quote_items")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String?       @db.Uuid
  bookingId      String        @db.Uuid
  quoteId        String?       @unique @db.Uuid
  invoiceNumber  String        @db.VarChar(40)
  status         InvoiceStatus @default(ISSUED)
  currency       String        @default("PKR") @db.Char(3)
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  dueAt          DateTime?
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  voidedAt       DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  quote          Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy      User          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items          InvoiceItem[]
  payments       Payment[]
  refunds        Refund[]

  @@unique([organizationId, invoiceNumber])
  @@index([bookingId, createdAt])
  @@index([organizationId, branchId, status, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  description String   @db.VarChar(240)
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("invoice_items")
}

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @db.Uuid
  branchId            String?       @db.Uuid
  invoiceId           String        @db.Uuid
  amount              Decimal       @db.Decimal(12, 2)
  currency            String        @default("PKR") @db.Char(3)
  method              PaymentMethod
  status              PaymentStatus @default(PENDING_VERIFICATION)
  reference           String?       @db.VarChar(180)
  idempotencyKey      String?       @db.VarChar(120)
  recordedById        String        @db.Uuid
  verifiedById        String?       @db.Uuid
  verifiedAt          DateTime?
  note                String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch              Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoice             Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy          User          @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  verifiedBy          User?         @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  refunds             Refund[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, branchId, status, createdAt])
  @@index([invoiceId, status])
  @@map("payments")
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String?      @db.Uuid
  paymentId      String       @db.Uuid
  invoiceId      String       @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  reference      String?      @db.VarChar(180)
  reason         String       @db.VarChar(500)
  processedById  String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  processedBy    User         @relation(fields: [processedById], references: [id], onDelete: Restrict)

  @@index([organizationId, branchId, createdAt])
  @@index([invoiceId, createdAt])
  @@map("refunds")
}

model BookingEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  bookingId      String       @db.Uuid
  actorUserId    String?      @db.Uuid
  fromStatus     BookingStatus?
  toStatus       BookingStatus
  note           String?      @db.Text
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, bookingId, createdAt])
  @@index([actorUserId])
  @@map("booking_events")
}

model RefreshSession {
  id             String       @id @default(uuid()) @db.Uuid
  familyId       String       @db.Uuid
  userId         String       @db.Uuid
  organizationId String?      @db.Uuid
  tokenHash      String       @unique @db.Char(64)
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@map("refresh_sessions")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String           @db.VarChar(240)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(uuid()) @db.Uuid
  role         OrganizationRole
  permissionId String           @db.Uuid
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  phone       String    @db.VarChar(32)
  codeHash    String    @db.Char(64)
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, consumedAt])
  @@map("otp_challenges")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String        @db.VarChar(100)
  resourceType   String?       @db.VarChar(80)
  resourceId     String?       @db.VarChar(80)
  ipAddress      String?       @db.VarChar(64)
  userAgent      String?       @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model NotificationTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String?             @db.Uuid
  eventKey       String              @db.VarChar(100)
  channel        NotificationChannel
  subject        String?             @db.VarChar(200)
  body           String              @db.Text
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  @@unique([organizationId, eventKey, channel])
  @@index([eventKey, channel, enabled])
  @@map("notification_templates")
}

model NotificationLog {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String?                    @db.Uuid
  userId            String?                    @db.Uuid
  eventKey          String                     @db.VarChar(100)
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(QUEUED)
  recipient         String?                    @db.VarChar(320)
  subject           String?                    @db.VarChar(200)
  body              String                     @db.Text
  providerReference String?                    @db.VarChar(200)
  error             String?                    @db.VarChar(500)
  metadata          Json?
  readAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  organization      Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([status, createdAt])
  @@map("notification_logs")
}

model AiUsageLog {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  userId            String       @db.Uuid
  task              String       @db.VarChar(80)
  provider          String       @db.VarChar(80)
  status            String       @db.VarChar(30)
  inputCharacters  Int          @default(0)
  outputCharacters Int          @default(0)
  metadata          Json?
  createdAt         DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([organizationId, task, createdAt])
  @@map("ai_usage_logs")
}

model SubscriptionPlan {
  id             String         @id @default(uuid()) @db.Uuid
  key            String         @unique @db.VarChar(40)
  name           String         @db.VarChar(100)
  description    String         @db.VarChar(500)
  monthlyPrice   Decimal        @default(0) @db.Decimal(12, 2)
  annualPrice    Decimal        @default(0) @db.Decimal(12, 2)
  currency       String         @default("PKR") @db.Char(3)
  maxBranches    Int?
  maxStaff       Int?
  maxMonthlyJobs Int?
  features       Json
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[]
  @@map("subscription_plans")
}

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  planId        String             @db.Uuid
  status        SubscriptionStatus @default(TRIAL)
  interval      String             @default("MONTHLY") @db.VarChar(20)
  periodStart   DateTime           @default(now())
  periodEnd     DateTime
  trialEndsAt   DateTime?
  canceledAt    DateTime?
  provider      String             @default("MANUAL") @db.VarChar(40)
  providerReference String?        @db.VarChar(200)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@index([organizationId, status, periodEnd])
  @@index([status, periodEnd])
  @@map("subscriptions")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(80)
  description String   @db.VarChar(300)
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("feature_flags")
}

model SupportTicket {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String?            @db.Uuid
  userId         String             @db.Uuid
  ticketNumber   String             @unique @db.VarChar(30)
  subject        String             @db.VarChar(180)
  description    String             @db.Text
  priority       String             @default("NORMAL") @db.VarChar(20)
  status         SupportTicketStatus @default(OPEN)
  assignedTo     String?            @db.VarChar(320)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, priority, createdAt])
  @@index([organizationId, createdAt])
  @@map("support_tickets")
}

model OrganizationInvite {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  branchId         String?          @db.Uuid
  invitedByUserId  String           @db.Uuid
  acceptedByUserId String?          @db.Uuid
  email            String           @db.VarChar(320)
  role             OrganizationRole @default(STAFF)
  tokenHash        String           @unique @db.Char(64)
  createdAt        DateTime         @default(now())
  expiresAt        DateTime
  acceptedAt       DateTime?
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invitedBy        User             @relation("InviteCreator", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?            @relation("InviteAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email, acceptedAt])
  @@index([expiresAt, acceptedAt])
  @@map("organization_invites")
}

model TechnicianProfile {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @db.Uuid
  memberId            String                  @unique @db.Uuid
  skills              String[]                @default([])
  employmentType      String                  @default("FULL_TIME") @db.VarChar(30)
  hourlyRate          Decimal?                @db.Decimal(12, 2)
  bio                 String?                 @db.Text
  isAvailable         Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member              OrganizationMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  availability        TechnicianAvailability[]
  timeOff             TechnicianTimeOff[]

  @@index([organizationId, isAvailable])
  @@map("technician_profiles")
}

model TechnicianAvailability {
  id           String            @id @default(uuid()) @db.Uuid
  profileId    String            @db.Uuid
  weekday      Int
  startMinute  Int
  endMinute    Int
  isAvailable  Boolean           @default(true)
  profile      TechnicianProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, weekday])
  @@map("technician_availability")
}

model TechnicianTimeOff {
  id            String            @id @default(uuid()) @db.Uuid
  profileId     String            @db.Uuid
  startsAt      DateTime
  endsAt        DateTime
  reason        String?           @db.VarChar(240)
  status        TimeOffStatus     @default(PENDING)
  reviewedById  String?           @db.Uuid
  createdAt     DateTime          @default(now())
  profile       TechnicianProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviewedBy    User?             @relation("TimeOffReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([profileId, startsAt, endsAt])
  @@map("technician_time_off")
}

model Supplier {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  name           String              @db.VarChar(180)
  phone          String?             @db.VarChar(32)
  email          String?             @db.VarChar(320)
  address        String?             @db.VarChar(500)
  notes          String?             @db.Text
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       InventoryProduct[]
  warrantyClaims WarrantyClaim[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive, name])
  @@map("suppliers")
}

model InventoryProduct {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  supplierId     String?          @db.Uuid
  sku            String           @db.VarChar(80)
  barcode        String?          @db.VarChar(100)
  name           String           @db.VarChar(180)
  category       String           @db.VarChar(100)
  manufacturer   String?          @db.VarChar(120)
  compatibleModels String[]       @default([])
  description    String?          @db.Text
  unit           String           @default("unit") @db.VarChar(30)
  unitCost       Decimal          @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal?         @db.Decimal(12, 2)
  reorderLevel   Decimal          @default(0) @db.Decimal(12, 2)
  tracksWarranty Boolean          @default(false)
  warrantyDays  Int?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stocks         InventoryStock[]
  movements      StockMovement[]
  warrantyClaims WarrantyClaim[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, category, isActive])
  @@map("inventory_products")
}

model InventoryStock {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  branchId       String          @db.Uuid
  productId      String          @db.Uuid
  quantity       Decimal         @default(0) @db.Decimal(12, 2)
  reserved       Decimal         @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime        @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product        InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([organizationId, branchId])
  @@map("inventory_stocks")
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  branchId       String            @db.Uuid
  productId      String            @db.Uuid
  bookingId      String?           @db.Uuid
  transferGroupId String?          @db.Uuid
  createdById    String            @db.Uuid
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 2)
  unitCost       Decimal?          @db.Decimal(12, 2)
  reference      String?           @db.VarChar(120)
  notes          String?           @db.VarChar(500)
  createdAt      DateTime          @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product        InventoryProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  booking        Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("StockMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, branchId, createdAt])
  @@index([productId, createdAt])
  @@index([transferGroupId])
  @@map("stock_movements")
}

model WarrantyClaim {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  branchId       String?             @db.Uuid
  assetId        String              @db.Uuid
  productId      String?             @db.Uuid
  supplierId     String?             @db.Uuid
  status         WarrantyClaimStatus @default(DRAFT)
  claimNumber    String              @db.VarChar(50)
  issue          String              @db.VarChar(1000)
  resolution     String?             @db.Text
  submittedAt    DateTime?
  resolvedAt     DateTime?
  createdById    String              @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  asset          Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  product        InventoryProduct?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier       Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([organizationId, claimNumber])
  @@index([organizationId, branchId, status, createdAt])
  @@index([assetId, createdAt])
  @@map("warranty_claims")
}
