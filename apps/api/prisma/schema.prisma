generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  TECHNICIAN
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  REQUESTED
  UNDER_REVIEW
  QUOTED
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  ASSIGNED
  TECHNICIAN_EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PropertyType {
  HOUSE
  APARTMENT
  COMMERCIAL
  OTHER
}

model User {
  id           String                 @id @default(uuid()) @db.Uuid
  email        String                 @unique @db.VarChar(320)
  phone        String?                @db.VarChar(32)
  fullName     String                 @db.VarChar(160)
  passwordHash String                 @db.VarChar(255)
  phoneVerifiedAt DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?
  memberships  OrganizationMember[]
  bookingEvents BookingEvent[]
  sessions      RefreshSession[]
  otpChallenges OtpChallenge[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]
  createdInvites OrganizationInvite[] @relation("InviteCreator")
  acceptedInvites OrganizationInvite[] @relation("InviteAccepter")

  @@index([phone])
  @@map("users")
}

model Organization {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @db.VarChar(180)
  slug        String               @unique @db.VarChar(100)
  businessType String?             @db.VarChar(80)
  currency    String               @default("PKR") @db.Char(3)
  timezone    String               @default("Asia/Karachi") @db.VarChar(64)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  members     OrganizationMember[]
  branches    Branch[]
  customers   Customer[]
  properties  Property[]
  assets      Asset[]
  services    Service[]
  bookings    Booking[]
  events      BookingEvent[]
  sessions    RefreshSession[]
  auditLogs   AuditLog[]
  invites     OrganizationInvite[]

  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(STAFF)
  status         MemberStatus     @default(INVITED)
  invitedAt      DateTime         @default(now())
  joinedAt       DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId       String?          @db.Uuid
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId, role, status])
  @@index([branchId])
  @@map("organization_members")
}

model Branch {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  name           String               @db.VarChar(160)
  city           String               @db.VarChar(100)
  address        String?              @db.VarChar(500)
  phone          String?              @db.VarChar(32)
  isDefault      Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  bookings       Booking[]
  customers      Customer[]
  invites        OrganizationInvite[]

  @@unique([organizationId, name])
  @@index([organizationId, city])
  @@map("branches")
}

model Customer {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  fullName       String            @db.VarChar(160)
  phone          String            @db.VarChar(32)
  email          String?           @db.VarChar(320)
  notes          String?           @db.Text
  tags           String[]          @default([])
  isActive       Boolean           @default(true)
  branchId       String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  addresses      CustomerAddress[]
  properties     Property[]
  bookings       Booking[]

  @@index([organizationId, phone])
  @@index([organizationId, fullName])
  @@index([organizationId, isActive, createdAt])
  @@index([branchId, isActive])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  label      String?  @db.VarChar(60)
  address    String   @db.VarChar(500)
  city       String   @db.VarChar(100)
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

model Property {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  customerId     String       @db.Uuid
  name           String       @db.VarChar(120)
  propertyType   PropertyType @default(HOUSE)
  address        String       @db.VarChar(500)
  city           String       @db.VarChar(100)
  ownership      String?      @db.VarChar(20)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assets         Asset[]
  bookings       Booking[]

  @@index([organizationId, customerId])
  @@index([organizationId, city])
  @@map("properties")
}

model Asset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  propertyId     String       @db.Uuid
  category       String       @db.VarChar(80)
  brand          String?      @db.VarChar(100)
  model          String?      @db.VarChar(100)
  serialNumber   String?      @db.VarChar(120)
  qrCode         String       @unique @default(uuid()) @db.VarChar(120)
  purchasedAt    DateTime?
  warrantyEndsAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings       Booking[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId, category])
  @@index([propertyId])
  @@map("assets")
}

model Service {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(160)
  category       String       @db.VarChar(80)
  description    String?      @db.Text
  basePrice      Decimal?     @db.Decimal(12, 2)
  durationMins   Int?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings       Booking[]

  @@unique([organizationId, name])
  @@index([organizationId, category, isActive])
  @@map("services")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String?       @db.Uuid
  customerId     String        @db.Uuid
  propertyId     String?       @db.Uuid
  assetId        String?       @db.Uuid
  serviceId      String?       @db.Uuid
  status         BookingStatus @default(REQUESTED)
  urgency        String        @default("NORMAL") @db.VarChar(20)
  description    String?       @db.Text
  preferredAt    DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  asset          Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  events         BookingEvent[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, branchId, scheduledAt])
  @@index([customerId, createdAt])
  @@map("bookings")
}

model BookingEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  bookingId      String       @db.Uuid
  actorUserId    String?      @db.Uuid
  fromStatus     BookingStatus?
  toStatus       BookingStatus
  note           String?      @db.Text
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, bookingId, createdAt])
  @@index([actorUserId])
  @@map("booking_events")
}

model RefreshSession {
  id             String       @id @default(uuid()) @db.Uuid
  familyId       String       @db.Uuid
  userId         String       @db.Uuid
  organizationId String?      @db.Uuid
  tokenHash      String       @unique @db.Char(64)
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@map("refresh_sessions")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String           @db.VarChar(240)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(uuid()) @db.Uuid
  role         OrganizationRole
  permissionId String           @db.Uuid
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  phone       String    @db.VarChar(32)
  codeHash    String    @db.Char(64)
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, consumedAt])
  @@map("otp_challenges")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String        @db.VarChar(100)
  resourceType   String?       @db.VarChar(80)
  resourceId     String?       @db.VarChar(80)
  ipAddress      String?       @db.VarChar(64)
  userAgent      String?       @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model OrganizationInvite {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  branchId         String?          @db.Uuid
  invitedByUserId  String           @db.Uuid
  acceptedByUserId String?          @db.Uuid
  email            String           @db.VarChar(320)
  role             OrganizationRole @default(STAFF)
  tokenHash        String           @unique @db.Char(64)
  createdAt        DateTime         @default(now())
  expiresAt        DateTime
  acceptedAt       DateTime?
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invitedBy        User             @relation("InviteCreator", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?            @relation("InviteAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email, acceptedAt])
  @@index([expiresAt, acceptedAt])
  @@map("organization_invites")
}
