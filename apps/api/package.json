{
  "name": "@gharsync/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/health/health.controller.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0", "@nestjs/config": "^12.0.1", "@nestjs/core": "^12.5.0", "@nestjs/platform-express": "^12.5.0",
    "@prisma/adapter-pg": "^7.10.1", "@prisma/client": "^7.10.1", "pg": "^8.16.3", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12", "@nestjs/schematics": "^12.0.13", "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.3", "@types/node": "^22.18.0", "@types/pg": "^8.15.5", "dotenv": "^18.0.3", "prisma": "^7.10.1", "tsx": "^4.20.6", "typescript": "^6.0.0"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
